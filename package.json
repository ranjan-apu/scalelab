{
  "name": "scalelab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:app\" \"npm run dev:landing\"",
    "dev:app": "vite",
    "dev:landing": "astro dev",
    "build": "tsc -b && astro build && vite build",
    "build:app": "tsc -b && vite build",
    "build:landing": "astro build",
    "preview": "astro preview",
    "preview:app": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.3.2",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "description": "System design and scale testing platform"
}
